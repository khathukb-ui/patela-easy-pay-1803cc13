# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/patela

# Auth
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional)
REDIS_URL=redis://redis:6379/0

# IMS Integration
IMS_BASE_URL=https://your-ims-api.example.com
IMS_API_KEY=your-ims-api-key

# Payment
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Feature Flags
FEATURE_OTP_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:5173","https://patela-easy-pay.lovable.app"]
